{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autobiz.scaffold.module.knowledge.v1",
  "title": "AutoBiz 知识模块配置 v1（modules/knowledge.json）",
  "description": "知识模块：清单解析、发布单元查询、知识组装；可选由插件拉取知识仓库。入口文件引用此文件即表示启用知识模块。语义校验见 input-config.md §7。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "清单解析方式。",
      "properties": {
        "format": { "enum": ["agents-manifest-v1"], "default": "agents-manifest-v1", "description": "v1 只支持 lite 的 agents.manifest.json 格式。" },
        "path": { "$ref": "#/definitions/relativeDir", "default": "agents.manifest.json", "description": "清单文件，相对知识目录 sys/。" }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "assembler": {
          "enum": ["plugin", "devclaw"],
          "default": "plugin",
          "description": "组装方。plugin：插件执行组装脚本 runtime/knowledge/render_collected_session_context.py（插件可以直接替换这个文件），结果并入 sessionContext；devclaw：由 DevClaw 组装，插件只提供清单解析结果。"
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "组装脚本的超时秒数；超时后本次会话不含知识段。"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "description": "可选：由插件拉取知识仓库，生成 sync_knowledge.py 与 pull_knowledge。",
      "properties": {
        "type": { "const": "git", "default": "git" },
        "url": { "type": "string", "minLength": 1 },
        "sshUrl": { "type": "string", "default": "" },
        "ref": { "type": "string", "default": "main" }
      }
    }
  },
  "definitions": {
    "relativeDir": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?!.*\\\\)(?!.*:)(?!(.*/)?\\.\\.(/|$)).+$",
      "description": "相对路径，不得以 / 开头、不得含 \\ : 或 .. 段。"
    }
  }
}
