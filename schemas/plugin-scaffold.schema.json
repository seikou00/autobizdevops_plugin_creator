{
  // 读法：properties 下面的键才是配置里能写的字段；required 列出必填字段；additionalProperties: false 表示不能写列表以外的字段，写错字段名会报错。
  // definitions 是可复用的片段，用 $ref 引用，不会出现在配置文件里；default 是不写时取的值，默认值只写在 Schema 里（D27）。
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autobiz.scaffold.input.v1",
  "title": "AutoBiz 插件脚手架入口文件 v1（plugin.scaffold.json）",
  "description": "插件基础信息、目录布局，以及对核心流程和各模块配置文件的引用。核心流程见 workflow.schema.json，模块配置见 modules/*.schema.json。语义校验见 input-config.md §7，Schema 只负责结构与取值范围。",
  "type": "object",
  "additionalProperties": false,
  "required": ["scaffoldVersion", "plugin"],
  "properties": {
    "$schema": { "type": "string" },
    // 入口文件格式版本，固定写 1
    "scaffoldVersion": { "const": 1, "description": "入口文件格式主版本。" },
    "plugin": { "$ref": "#/definitions/plugin" },
    "runtime": { "$ref": "#/definitions/runtime" },
    // 核心流程文件路径，默认 ./workflow.json，一般不用写
    "workflow": {
      "$ref": "#/definitions/fileRef",
      "default": "./workflow.json",
      "description": "核心流程文件，相对插件根目录。"
    },
    // 引用模块配置文件：board、session 不引用就全部取默认值；knowledge、artifactSync 引用即启用，不引用即不启用
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "description": "模块配置文件引用。board、session 不引用时全部取默认值；knowledge、artifactSync 引用即启用，不引用即不启用。",
      "properties": {
        "board": { "$ref": "#/definitions/fileRef", "description": "看板模块配置，建议 ./modules/board.json。" },
        "session": { "$ref": "#/definitions/fileRef", "description": "会话与 Agent 配置，建议 ./modules/session.json。" },
        "knowledge": { "$ref": "#/definitions/fileRef", "description": "知识模块配置，建议 ./modules/knowledge.json。" },
        "artifactSync": { "$ref": "#/definitions/fileRef", "description": "产物同步模块配置，建议 ./modules/artifactSync.json。" }
      }
    }
  },
  "definitions": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    // 文件引用格式：以 ./ 开头的 .json 相对路径，不能含 ..
    "fileRef": {
      "type": "string",
      "pattern": "^\\./(?!(.*/)?\\.\\.(/|$))[^\\\\:]+\\.json$",
      "description": "相对插件根目录的 JSON 文件路径，以 ./ 开头，不得含 .. 段。"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description"],
      "properties": {
        // 插件稳定 ID：state.json 里的 pluginId、元数据目录名、安装目录名都用它；发布后不能改，否则旧项目的状态读不到
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "not": { "enum": ["features", "archive", "issues", "reviews", "logs", "plugins"] },
          "description": "插件稳定 ID：state.json.pluginId、隔离布局下的元数据目录名、安装目录名（以及可选 Codex 清单的 name）相同。发布后不可修改，否则旧项目状态无法读取。不得使用元数据根目录（runtime.metaRoot）下的保留目录名。"
        },
        // 看板上显示的插件名，可含大写，可以改
        "name": { "$ref": "#/definitions/nonEmpty", "description": "根 plugin.json.name（DevClaw 沿用的展示名，可含大写）。" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "description": { "$ref": "#/definitions/nonEmpty" },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        "homepage": { "type": "string" },
        "repository": { "type": "string" },
        "license": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        // mcpServers、hooks：原样写进 plugin.json，指向的文件由开发者自己维护
        "mcpServers": { "type": "string", "pattern": "^\\./", "description": "透传到清单 mcpServers，例如 ./.mcp.json；文件由开发者维护。" },
        "hooks": { "type": "string", "pattern": "^\\./", "description": "透传到根 plugin.json.hooks，例如 ./hooks/hooks.json；文件由开发者维护。" },
        // 是否额外生成 Codex 用的 .codex-plugin/plugin.json；DevClaw 只读根 plugin.json，不需要兼容 Codex 就不用开
        "codexManifest": {
          "type": "boolean",
          "default": false,
          "description": "是否额外生成 .codex-plugin/plugin.json。DevClaw 只读根 plugin.json，需要兼容 Codex 时再开启。"
        },
        // Codex 清单的展示信息，只在 codexManifest 为 true 时有用，大多数插件不用写
        "interface": { "$ref": "#/definitions/pluginInterface", "description": "仅在 codexManifest 为 true 时使用。" }
      }
    },
    "pluginInterface": {
      "type": "object",
      "additionalProperties": false,
      "description": "Codex 清单 interface 块，字段与 Codex plugin-creator 的 plugin-json-spec 一致；只输出声明了的字段。",
      "properties": {
        "displayName": { "type": "string", "description": "缺省取 plugin.name。" },
        "shortDescription": { "type": "string", "description": "缺省取 plugin.description。" },
        "longDescription": { "type": "string" },
        "developerName": { "type": "string" },
        "category": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "websiteURL": { "type": "string" },
        "privacyPolicyURL": { "type": "string" },
        "termsOfServiceURL": { "type": "string" },
        "defaultPrompt": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "maxLength": 128 },
          "description": "最多 3 条，每条不超过 128 字符（建议约 50 字符）。"
        },
        "brandColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "composerIcon": { "type": "string", "pattern": "^\\./assets/" },
        "logo": { "type": "string", "pattern": "^\\./assets/" },
        "screenshots": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\./assets/.+\\.png$" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        // 元数据根目录：状态和产物都放在项目目录下的这个目录里。可以写多级相对路径，不能是 .git。发布后不能改，否则已有项目的状态和产物找不到；迁移 lite、全栈版时保持默认
        "metaRoot": {
          "type": "string",
          "pattern": "^(?!~)(?!.*\\\\)(?!.*:)(?!(.*/)?\\.{1,2}(/|$))(?!\\.git(/|$))[^/]+(/[^/]+)*$",
          "default": ".autobizdevops",
          "description": "元数据根目录，相对项目目录。isolated 布局下元数据目录为 <metaRoot>/<pluginId>，legacy 布局下为 <metaRoot>。发布后不可修改。"
        },
        // 元数据目录布局：isolated 每个插件一个目录，同一项目可装多个插件；legacy 只用于迁移 lite、全栈版这类已有插件。发布后不能改
        "layout": {
          "enum": ["isolated", "legacy"],
          "default": "isolated",
          "description": "元数据与产物目录布局。isolated：<metaRoot>/<pluginId>/，同一项目可装多个插件；legacy：<metaRoot>/ 根目录，仅用于迁移已有插件（例如 lite），保持其已有项目可用。发布后不可修改。"
        },
        // 节点 validate 命令最多跑多久，超时算校验不通过
        "validateTimeoutSec": {
          "type": "integer",
          "minimum": 1,
          "default": 120,
          "description": "节点校验命令的超时秒数。"
        }
      }
    }
  }
}
