    "darwin": {
      "session_context_inject": "python3 -X utf8 \"${pluginPath}/runtime/session/render_session_context.py\" --platform darwin --plugin-workspace \"${pluginWorkspace}\" --project \"${projectDir}\" --feature \"${feature}\" --selected-deployUnit ${selectedDeployUnits} --session-workspace-path \"${sessionWorkspacePath}\" --knowledge-path \"${pluginPath}/sys\" --knowledge-path-platform \"${knowledgePath}\"",
