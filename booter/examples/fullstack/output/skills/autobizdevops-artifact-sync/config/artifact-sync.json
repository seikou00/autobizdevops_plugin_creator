{
  "schemaVersion": 3,
  "allowedCheckpoints": [
    "plan_done",
    "code_done",
    "cicd_in_progress",
    "cicd_done",
    "archived"
  ],
  "uploadUrl": "https://tscode-cos-plugin.paasuat.cmbchina.cn/file/upload",
  "maxFileSizeMiB": 5,
  "stages": {
    "Biz": {
      "prd": {
        "PRD.md": "正式产品需求文档。"
      }
    },
    "Dev": {
      "specs": {
        "proposal.md": "行为规格总览。",
        "specs/**/*.md": "行为规格明细。"
      },
      "design": {
        "design.md": "技术设计文档。"
      },
      "plan": {
        "PLAN.md": "开发执行计划。"
      }
    }
  },
  "extraPaths": {
    "prd_original/**/*": "原始需求文档或参考材料。",
    "sources/**/*": "外部资料原件或 Feature 固定快照。"
  }
}
