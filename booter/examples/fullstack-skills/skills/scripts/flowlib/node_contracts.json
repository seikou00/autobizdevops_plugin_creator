{
  "$comment": "插件自己的节点契约扩展：运行框架的 flow.json 只有节点、产物和 checkpoint，这里补上流程脚本用到的输入产物（含缺失时的处理说明）、校验器清单、守卫和回退时要归档的目录。键是 workflow.json 中的节点 id；输出产物以 flow.json 为准，这里的 outputs 只提供显示名。refreshUiContextMd 为 true 的节点，完成前校验通过后由 hooks/stage_gate_guard.py 重建 Plan 前的 UI_CONTEXT.md。",
  "nodes": {
    "prd": {
      "inputs": [],
      "outputs": [
        {
          "path": "PRD.md",
          "label": "PRD文档"
        },
        {
          "path": "UI_CONTEXT.json",
          "label": "UI范围机器事实源"
        }
      ],
      "validators": [
        "ui_context_json"
      ],
      "rollback": {
        "archive": [
          "source-context.json"
        ]
      }
    },
    "specs": {
      "inputs": [
        {
          "id": "prd",
          "label": "PRD文档",
          "path": "PRD.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无 PRD 时基于用户描述直接澄清行为契约，沉淀到 proposal 与 specs"
          }
        },
        {
          "id": "ui_context_json",
          "label": "UI范围",
          "path": "UI_CONTEXT.json",
          "kind": "json",
          "required": true,
          "extract": {
            "degrade": "无 UI_CONTEXT.json 时，本阶段必须基于用户已确认范围生成并锁定，不能从 PRD 正文临时推导"
          }
        }
      ],
      "outputs": [
        {
          "path": "proposal.md",
          "label": "变更提案"
        },
        {
          "path": "specs/**/*.md",
          "label": "行为规格"
        },
        {
          "path": "UI_CONTEXT.json",
          "label": "UI范围"
        }
      ],
      "validators": [
        "proposal_contract",
        "specs_contract",
        "capability_spec_correspondence",
        "ui_context_json"
      ],
      "rollback": {
        "archive": [
          "SPECS_REVIEW.md"
        ]
      },
      "refreshUiContextMd": true
    },
    "design": {
      "inputs": [
        {
          "id": "proposal",
          "label": "变更提案",
          "path": "proposal.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无 proposal 时基于用户直供需求与代码探索建立上下文，并把边界假设记入 design.md 风险"
          }
        },
        {
          "id": "specs",
          "label": "行为规格",
          "path": "specs/**/*.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无 specs 时与用户确认行为预期后再设计，未确认行为全部记为待确认风险"
          }
        },
        {
          "id": "ui_context_json",
          "label": "UI范围",
          "path": "UI_CONTEXT.json",
          "kind": "json",
          "required": true,
          "extract": {
            "degrade": "无 UI_CONTEXT.json 时回到 /autodev-specs 补齐并锁定，不能自行推断 UI 范围"
          }
        }
      ],
      "outputs": [
        {
          "path": "design.md",
          "label": "技术设计"
        },
        {
          "path": ".design-contract.lock.json",
          "label": "设计契约锁"
        }
      ],
      "validators": [
        "design_contract",
        "design_contract_lock",
        "ui_context_json"
      ]
    },
    "plan": {
      "inputs": [
        {
          "id": "proposal",
          "label": "变更提案",
          "path": "proposal.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无 proposal 时回到 /autodev-design 补齐设计依据，再重新生成计划"
          }
        },
        {
          "id": "specs",
          "label": "行为规格",
          "path": "specs/**/*.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无 specs 时回到 /autodev-specs 补齐行为契约，不能只凭 design.md 拆任务"
          }
        },
        {
          "id": "ui_context_json",
          "label": "UI范围",
          "path": "UI_CONTEXT.json",
          "kind": "json",
          "required": true,
          "extract": {
            "degrade": "无 UI_CONTEXT.json 时回到 /autodev-specs 补齐并锁定，不能自行推断 UI 任务"
          }
        },
        {
          "id": "design",
          "label": "已确认技术设计",
          "path": "design.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无 design.md 时回到 /autodev-design 生成并确认技术设计，不能直接生成计划"
          }
        },
        {
          "id": "design_contract_lock",
          "label": "Design 已锁定契约",
          "path": ".design-contract.lock.json",
          "kind": "json",
          "required": true,
          "extract": {
            "degrade": "缺少设计契约锁说明 /autodev-design 未完成；回到 Design 校验并生成锁后再进入 Plan"
          }
        }
      ],
      "outputs": [
        {
          "path": "PLAN.md",
          "label": "执行计划"
        },
        {
          "path": "plan.json",
          "label": "计划机器结构化内容"
        }
      ],
      "validators": [
        "ui_context_json",
        "plan_json_contract",
        "plan_json_initial_tasks",
        "parallel_batch_pipeline_contract",
        "plan_task_granularity",
        "plan_scenario_coverage"
      ],
      "rollback": {
        "archive": [
          "plans"
        ]
      }
    },
    "code": {
      "inputs": [
        {
          "id": "proposal",
          "label": "变更提案",
          "path": "proposal.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无 proposal 时以已有产物理解需求;如果都没有则根据用户直供需求作为范围依据"
          }
        },
        {
          "id": "specs",
          "label": "行为规格",
          "path": "specs/**/*.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无 specs 时以已有产物理解需求;如果都没有则根据用户直供需求作为范围依据"
          }
        },
        {
          "id": "prd_optional",
          "label": "PRD参考",
          "path": "PRD.md",
          "kind": "file",
          "required": false,
          "extract": {
            "degrade": "无 PRD 时，以已有产物理解需求;如果都没有则根据用户直供需求作为范围依据"
          }
        },
        {
          "id": "design",
          "label": "技术设计",
          "path": "design.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无 design 时基于 已有产物 与现有代码模式自行做最小实现决策，并在完成摘要中记录关键决策"
          }
        },
        {
          "id": "plan_json",
          "label": "计划机器事实源",
          "path": "plan.json",
          "kind": "json",
          "required": true,
          "extract": {
            "degrade": "无 plan.json 或结构已过时时，回到 /autodev-plan 清理并按当前唯一结构重新生成；不得建立旁路任务队列"
          }
        },
        {
          "id": "detail_design_optional",
          "label": "详细设计参考",
          "path": "DETAIL_DESIGN.md",
          "kind": "file",
          "required": false,
          "extract": {
            "degrade": "无 DETAIL_DESIGN 时按 design.md 与 PLAN.md 的任务执行包直接实现"
          }
        },
        {
          "id": "ui_context_json",
          "label": "UI范围机器事实源",
          "path": "UI_CONTEXT.json",
          "kind": "json",
          "required": true,
          "extract": {
            "degrade": "无 UI_CONTEXT.json 时先询问用户是否需要生成前端代码，再回到 /autodev-specs 或 /autodev-plan 补齐"
          }
        }
      ],
      "outputs": [
        {
          "path": "evidence/EVIDENCE.jsonl",
          "label": "证据流"
        }
      ],
      "validators": [
        "ui_context_json",
        "plan_json_contract",
        "plan_task_detail_schema",
        "plan_ref_resolution",
        "frontend_route_gate",
        "evidence_detail_quality",
        "code_done_gate",
        "evidence_integrity"
      ],
      "guards": [
        "code_compile"
      ],
      "rollback": {
        "archive": [
          ".parallel-runs",
          ".task-runs",
          ".runtime",
          ".engineering",
          ".frontend/html-analysis",
          ".frontend/html-input",
          "evidence",
          "FRONTEND_ROUTE.json",
          "SMOKE_TEST_PLAN.json",
          "SMOKE_RESULT.json",
          "completion-proposal.json",
          "REQUIREMENTS_EVAL.md",
          "UNIT_TEST_REPORT.md",
          "UNIT_TEST_RESULT.json",
          "UTEST_ENVIRONMENT.json",
          "UTEST_EXECUTION.json",
          "test-output.log",
          "E2E_TEST_CASES.yaml",
          "E2E_REPORT.md",
          "E2E_RESULT.json",
          "E2E_QUALITY_SCAN.json",
          "e2e-run.log",
          "e2e-diagnostics",
          "VERIFY_REPORT.md",
          "VERIFY_DECISION.json",
          "FIX_REQUEST.json",
          "FEATURE_API_DETAIL.md",
          "ARTIFACT_CATALOG.json",
          "sync-status.json",
          "artifact-sync",
          "hooks.ndjson"
        ]
      }
    },
    "cicd": {
      "inputs": [
        {
          "id": "evidence_stream",
          "label": "批次流水线验证证据",
          "path": "evidence/EVIDENCE.jsonl",
          "kind": "json",
          "required": true,
          "extract": {
            "degrade": "缺失时回到 Code 的 Batch 流水线补齐 review 与交付证据"
          }
        },
        {
          "id": "prd_optional",
          "label": "PRD参考",
          "path": "PRD.md",
          "kind": "file",
          "required": false,
          "extract": {
            "degrade": "未提供时允许继续，写明需求文档缺失或未提供"
          }
        },
        {
          "id": "design_optional",
          "label": "技术设计参考",
          "path": "design.md",
          "kind": "file",
          "required": false,
          "extract": {
            "degrade": "未提供时允许继续，写明设计文档缺失或未提供"
          }
        }
      ],
      "outputs": [
        {
          "path": "CICD_CHECKLIST.md",
          "label": "CI/CD 清单"
        },
        {
          "path": "PR_BODY.md",
          "label": "PR 描述"
        }
      ],
      "validators": []
    },
    "archive": {
      "inputs": [
        {
          "id": "cicd_checklist",
          "label": "CI/CD 清单",
          "path": "CICD_CHECKLIST.md",
          "kind": "file",
          "required": true,
          "extract": {
            "degrade": "无清单时按 Feature 目录现有产物核对后归档，并标注缺项"
          }
        }
      ],
      "outputs": [],
      "validators": []
    }
  }
}
