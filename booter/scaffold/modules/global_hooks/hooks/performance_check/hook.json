{
  "id": "performance-check",
  "title": "前端性能检查",
  "description": "节点 code 推进到 code_done 前，按 7 条前端性能规则检查工作区 git diff 中改动的 .js/.ts/.vue 等文件，有问题就拦下；编码节点的 id 不是 code 时不会触发",
  "files": ["performance_checker.py"],
  "entries": {
    "PreToolUse": [
      {
        "matcher": "execute",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 ${hookDir}/performance_checker.py code_done",
            "timeout": 7200,
            "persistAfterInterrupt": true
          }
        ]
      }
    ]
  }
}
