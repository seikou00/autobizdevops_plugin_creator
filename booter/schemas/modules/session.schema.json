{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autobiz.scaffold.module.session.v1",
  "title": "AutoBiz 运行策略配置 v1（modules/session.json）",
  "description": "设置全局和逐节点的运行方式、子代理与工具开关。省略此文件时，各节点沿用 multi。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "全局默认策略和各节点的覆盖配置。",
      "properties": {
        "default": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agentMode": { "$ref": "#/definitions/agentMode", "default": "multi" },
            "subagentConfig": { "$ref": "#/definitions/subagentConfig" },
            "toolCustomConfig": { "$ref": "#/definitions/toolCustomConfig" }
          },
          "default": {},
          "description": "所有节点的默认策略，agentMode 默认 multi。单独配置的节点与它合并，没写的字段沿用这里的。"
        },
        "nodes": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "description": "单独配置的节点，按 biz、dev、ops 分组，组要与节点在 workflow.json 中所在的组一致；只写需要单独配置的节点。",
          "properties": {
            "biz": { "$ref": "#/definitions/stagePolicies" },
            "dev": { "$ref": "#/definitions/stagePolicies" },
            "ops": { "$ref": "#/definitions/stagePolicies" }
          }
        }
      }
    }
  },
  "definitions": {
    "nodeId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "workflow.json 中的节点 id。" },
    "stagePolicies": {
      "type": "array",
      "minItems": 1,
      "description": "本阶段需要自定义运行策略的节点。",
      "items": { "$ref": "#/definitions/nodePolicy" }
    },
    "nodePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "单个节点的运行策略。省略的字段沿用全局默认策略。",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "agentMode": { "$ref": "#/definitions/agentMode" },
        "subagentConfig": { "$ref": "#/definitions/subagentConfig" },
        "toolCustomConfig": { "$ref": "#/definitions/toolCustomConfig" }
      }
    },
    "agentMode": { "enum": ["solo", "multi", "agent_team", "workflow"], "description": "运行方式，由 DevClaw 解释。" },
    "subagentConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "子代理配置。",
      "properties": {
        "disabledBuiltinSubagents": { "type": "array", "items": { "type": "string" }, "description": "要禁用的内置子代理名，例如 Explore、critic。" },
        "customSubagentFiles": {
          "type": "array",
          "description": "插件自带的子代理文件，放在插件的 agents/ 下，例如 agents/explore.md；文件不存在时运行时跳过。",
          "items": { "type": "string", "pattern": "^agents/(?!.*\\.\\.)[^\\\\:]+\\.md$" }
        }
      }
    },
    "toolCustomConfig": {
      "type": "object",
      "description": "宿主工具的开关，例如 { \"task\": { \"enabled\": true } }，原样下发给 DevClaw。"
    }
  }
}
