{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autobiz.scaffold.module.artifactSync.v1",
  "title": "AutoBiz 产物同步模块配置 v1（modules/artifactSync.json）",
  "description": "产物同步模块：把产物上传到外部服务，并在看板上生成同步入口。入口文件引用此文件即表示启用，不引用即不启用（D30）。语义校验见 input-config.md §7。",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "skillName": { "$ref": "#/definitions/skillName", "default": "autobizdevops-artifact-sync" },
    "allowedFrom": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(:(in_progress|done))?$",
      "description": "<nodeId>:<in_progress|done> 或 checkpoint 名；从该点到流程末尾都允许同步。"
    },
    "excludeCheckpoints": { "type": "array", "items": { "type": "string" }, "default": [] },
    "allowedCheckpoints": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "显式列表，与 allowedFrom 二选一。"
    },
    "artifacts": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/definitions/nonEmpty" },
      "description": "要上传的产物清单：产物路径（workflow.json 某个节点 outputs 中的路径）→ 同步目录中的简述。只同步列出的产物，归属节点从节点输出推导。"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "看板上的产物同步入口，生成 board_core/modules.json 顶层 artifact_sync（slashSkill 固定为 skillName）。",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "syncType": { "type": "string", "default": "invoke_session" },
        "userMessage": { "type": "string", "default": "请针对${projectCode}项目的${feature}特性发起产物同步" },
        "dialogTips": { "type": "string", "default": "发起产物同步" }
      }
    },
    "uploadUrl": { "type": "string", "pattern": "^https?://", "default": "https://tscode-cos-plugin.paasuat.cmbchina.cn/file/upload", "description": "上传服务地址。" },
    "maxFileSizeMiB": { "type": "integer", "minimum": 1, "default": 5 },
    "extraPaths": {
      "type": "object",
      "default": {},
      "description": "不属于节点输出但需要同步的路径：{ 路径模式（相对 FEATURE_DIR）: 简述 }，不按阶段和节点归属。",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/definitions/nonEmpty" }
    }
  },
  "oneOf": [
    { "required": ["allowedFrom"], "not": { "required": ["allowedCheckpoints"] } },
    { "required": ["allowedCheckpoints"], "not": { "required": ["allowedFrom"] } }
  ],
  "definitions": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "skillName": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 }
  }
}
