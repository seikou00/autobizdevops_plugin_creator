{
  "$schema": "../schemas/plugin-scaffold.schema.json",
  "scaffoldVersion": 1,
  "plugin": {
    "id": "autodev-planning-kanban",
    "name": "AutoBizDevOps-Plugin-Lite",
    "version": "1.1.6",
    "description": "需求、规格、计划与增量编码四阶段插件，知识同步、上下文加载。",
    "author": {
      "name": "Local developer"
    },
    "keywords": ["requirements", "specs", "planning", "incremental-code", "kanban"]
  },
  "runtime": {
    "utf8Mode": false,
    "layout": "legacy"
  },
  "board": {
    "workflowLabel": "需求开发"
  },
  "stages": [
    { "id": "biz", "label": "Biz" },
    { "id": "dev", "label": "Dev" }
  ],
  "artifacts": {
    "requirements": { "label": "结构化需求", "path": "PRD.md" },
    "proposal": { "label": "变更提案", "path": "proposal.md" },
    "specs": { "label": "行为规格", "path": "specs/*/spec.md" },
    "design": { "label": "技术设计", "path": "design.md" },
    "plan": { "label": "实施计划", "path": "plan.md", "legacyPaths": ["PLAN.md"] }
  },
  "nodes": [
    {
      "id": "biz.prd",
      "label": "需求清洗",
      "skill": "autobiz-prd",
      "outputs": ["requirements"]
    },
    {
      "id": "dev.specs",
      "label": "规格生成",
      "skill": "autodev-sepc",
      "inputs": ["requirements"],
      "outputs": ["proposal", "specs", "design"],
      "runtimePolicy": {
        "agentMode": "multi",
        "toolCustomConfig": { "task": { "enabled": true } },
        "subagentConfig": {}
      }
    },
    {
      "id": "dev.plan",
      "label": "任务计划",
      "skill": "autodev-plan",
      "description": "任务计划；产物：plan.md，包含输入文件、实现范围、任务依赖图和 Phase 划分。",
      "inputs": ["requirements", "proposal", "specs", "design"],
      "outputs": ["plan"],
      "runtimePolicy": {
        "agentMode": "multi",
        "toolCustomConfig": { "task": { "enabled": true } },
        "subagentConfig": {
          "disabledBuiltinSubagents": ["Explore", "critic"],
          "customSubagentFiles": ["agents/explore.md", "agents/critic_autodev_plan_zh.md"]
        }
      },
      "nextAction": {
        "done": {
          "userMessage": "实现当前feature",
          "dialogTips": "计划已完成；用户要求实施时进入增量编码。"
        }
      }
    },
    {
      "id": "dev.code",
      "label": "增量编码",
      "skill": "autodev-code",
      "description": "实现当前 Feature 的 plan.md，你应该先读技能，理解技能后在进行任务规划",
      "inputs": ["requirements", "proposal", "specs", "design", "plan"],
      "outputs": [],
      "runtimePolicy": { "agentMode": "agent_team" },
      "nextAction": {
        "active": {
          "userMessage": "实现当前feature,先调研清楚实施计划，再由协调者按phase分阶段分配worker实施",
          "dialogTips": "当前阶段：增量编码。team 模式按 Phase 分发，worker 开始前读取技能与计划。"
        },
        "done": {
          "dialogTips": "编码已完成。"
        }
      }
    }
  ],
  "modules": {
    "knowledge": {
      "enabled": true,
      "agentsRepo": {
        "url": "https://gitee.paas.cmbchina.cn/S992391/LF39_Product_Knowledge.git",
        "sshUrl": "git@gitee.itc.cmbchina.cn:S992391/LF39_Product_Knowledge.git",
        "ref": "master"
      },
      "sedimentation": {
        "enabled": true
      }
    },
    "artifactSync": {
      "enabled": true,
      "allowedFrom": "dev.plan:done",
      "apiDetail": { "enabled": true, "node": "dev.code" }
    }
  }
}
