{
  "schemaVersion": 2,
  "allowedCheckpoints": [
    "plan_done",
    "code_done",
    "cicd_in_progress",
    "cicd_done",
    "archived"
  ],
  "uploadUrl": "https://tscode-cos-plugin.paasuat.cmbchina.cn/file/upload",
  "maxFileSizeMiB": 5,
  "stages": {
    "Biz": {
      "biz.prd": {
        "PRD.md": "正式产品需求文档。",
        "prd_original/**/*": "原始需求文档或参考材料。",
        "sources/**/*": "外部资料原件或 Feature 固定快照。"
      }
    },
    "Dev": {
      "dev.specs": {
        "proposal.md": "行为规格总览。",
        "specs/**/*.md": "行为规格明细。"
      },
      "dev.design": {
        "design.md": "技术设计文档。"
      },
      "dev.plan": {
        "PLAN.md": "开发执行计划。"
      },
      "dev.detail_design": {
        "DETAIL_DESIGN.md": "文件级详细设计文档。"
      }
    }
  }
}
