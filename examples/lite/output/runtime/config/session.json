{
  "schema": "autobiz.session.v1",
  "policies": {
    "default": {
      "agentMode": "solo"
    },
    "nodes": {
      "dev.specs": {
        "agentMode": "multi",
        "toolCustomConfig": {
          "task": {
            "enabled": true
          }
        },
        "subagentConfig": {}
      },
      "dev.plan": {
        "agentMode": "multi",
        "toolCustomConfig": {
          "task": {
            "enabled": true
          }
        },
        "subagentConfig": {
          "disabledBuiltinSubagents": [
            "Explore",
            "critic"
          ],
          "customSubagentFiles": [
            "agents/explore.md",
            "agents/critic_autodev_plan_zh.md"
          ]
        }
      },
      "dev.code": {
        "agentMode": "agent_team"
      }
    }
  },
  "knowledgeAssembly": {
    "script": "runtime/knowledge/render_collected_session_context.py",
    "timeoutSec": 30
  }
}
