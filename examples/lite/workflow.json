{
  "$schema": "../../schemas/workflow.schema.json",
  "nodes": [
    {
      "id": "biz.prd",
      "name": "需求清洗",
      "stage": "Biz",
      "skill": "autobiz-prd",
      "outputs": { "requirements": "PRD.md" }
    },
    {
      "id": "dev.specs",
      "name": "规格生成",
      "stage": "Dev",
      "skill": "autodev-sepc",
      "inputs": ["requirements"],
      "outputs": { "proposal": "proposal.md", "specs": "specs/*/spec.md", "design": "design.md" }
    },
    {
      "id": "dev.plan",
      "name": "任务计划",
      "stage": "Dev",
      "skill": "autodev-plan",
      "inputs": ["requirements", "proposal", "specs", "design"],
      "outputs": { "plan": "plan.md" }
    },
    {
      "id": "dev.code",
      "name": "增量编码",
      "stage": "Dev",
      "skill": "autodev-code",
      "inputs": ["requirements", "proposal", "specs", "design", "plan"]
    }
  ]
}
