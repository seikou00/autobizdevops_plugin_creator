      "dynamic_workflow": "python -X utf8 \"${pluginPath}/runtime/adapters/inspect_workflow_templates.py\"",
      "plugin_dir_hook": "${pluginWorkspace}/${projectDir}",
      "dialog_tips": "当前为Doc-Review-Kanban插件：起草 → 评审。请描述目标与验收标准。",
      "system_prompt_inject": "当前 Feature 为 ${feature}。产物目录 FEATURE_DIR=${pluginWorkspace}/${projectDir}/.autobizdevops/doc-review/features/${feature}。插件根目录 PLUGIN_ROOT=${pluginPath}。",
