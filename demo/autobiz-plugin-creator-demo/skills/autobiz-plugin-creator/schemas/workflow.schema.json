{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autobiz.scaffold.workflow.v1",
  "title": "核心流程 workflow.json",
  "description": "人与 agent 共同维护的最小流程骨架。Schema 只检查字段名、类型和必填项；引用、顺序、路径安全、命令格式等规则由 autobiz-plugin lint 检查（input-config.md §7）。插件运行时使用的是编译结果 runtime/config/flow.json。",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "$schema": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "description": "节点，数组顺序即执行顺序。",
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "artifactId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "paths": {
      "description": "相对 FEATURE_DIR 的路径，可含 glob；数组表示每一项都要存在。",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "skill"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "description": "节点 id，可用 . 分段（例如 dev.plan）；最后一段作为 checkpoint 前缀。"
        },
        "name": { "type": "string", "minLength": 1, "description": "节点显示名。" },
        "stage": { "type": "string", "minLength": 1, "description": "所属阶段名（例如 Biz、Dev），用作看板分组。" },
        "skill": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "绑定的技能，对应 skills/<skill>/SKILL.md。"
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifactId" },
          "description": "读取的产物 id，必须由前面的节点输出。"
        },
        "outputs": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/artifactId" },
          "additionalProperties": { "$ref": "#/definitions/paths" },
          "description": "产出的产物：{ 产物 id: 路径 }。"
        },
        "templates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "模板文件，相对本节点的技能目录 skills/<skill>/。"
        },
        "validate": {
          "type": "string",
          "minLength": 1,
          "description": "节点完成时执行的单行校验命令，退出码 0 才放行。"
        }
      }
    }
  }
}
